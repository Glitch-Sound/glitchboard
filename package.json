{
  "name": "glitchboard-workspace",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "biome check .",
    "check:fsd": "CHOKIDAR_USEPOLLING=1 steiger packages/webview/src",
    "build": "vite build --config packages/webview/vite.config.ts && vite build --config packages/extension/vite.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@feature-sliced/steiger-plugin": "^0.5.0",
    "@playwright/test": "^1.56.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/vscode": "^1.105.0",
    "@vscode/vsce": "^3.6.0",
    "jsdom": "^27.0.0",
    "lefthook": "^2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "steiger": "^0.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
