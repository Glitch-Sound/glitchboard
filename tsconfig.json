{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx"
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "tests/**/*.ts"]
}
